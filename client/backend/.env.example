ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (the existing PostgreSQL). Inside Docker later: DATABASE_HOST=postgres on postgres_network.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=starter_app
DATABASE_USER=postgres
DATABASE_PASSWORD=REPLACE_ME
DATABASE_SCHEMA=client

# Application
CORS_ORIGINS=http://localhost:5174

# MFA
MFA_TITLE=Starter Application
# Generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MFA_ENCRYPTION_KEY=REPLACE_WITH_SECURE_KEY
MFA_ENCRYPTION_KEY_ID=k1
# During rotation: comma-separated key_id:key pairs that may still decrypt.
MFA_ENCRYPTION_PREVIOUS_KEYS=
CLIENT_MFA_REQUIRED=false

# Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_SESSION_EXPIRE_DAYS=7
# Must stay true anywhere served over HTTPS. Set false only for http://localhost development.
COOKIE_SECURE=false
# Public self-registration stays off until a policy is explicitly chosen.
REGISTRATION_ENABLED=false

# Argon2id
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4
